{
  "schemaVersion": 1,
  "id": "footstepstrail",
  "version": "${version}",
  "name": "Footsteps Trail",
  "description": "Leave fading footprints behind you as you explore. Prints sink into sand, snow and mud, or use surface and classic markers. Client-side and fully configurable.",
  "authors": [
    "Blue Print"
  ],
  "contact": {
    "homepage": "https://github.com/RealSatellite/Footsteps-trail",
    "sources": "https://github.com/RealSatellite/Footsteps-trail"
  },
  "license": "MIT",
  "icon": "assets/footstepstrail/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.footstepstrail.fabric.FootstepsTrailFabricClient"
    ],
    "modmenu": [
      "dev.footstepstrail.fabric.compat.ModMenuIntegration"
    ]
  },
  "mixins": ["footstepstrail.deformation.mixins.json", "footstepstrail.indigo.mixins.json", "footstepstrail.renderers.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
